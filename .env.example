# Copy to .env and fill in. Loaded by dotenv in development and test only.

# Local database — consumed by config/database.yml and docker/compose-dev.yaml
DB_HOST=localhost
DB_PORT=5454
DB_USERNAME=simi
DB_PASSWORD=123456

# Mailpit from docker/compose-dev.yaml. Use "mailpit" when the app runs inside compose.
SMTP_HOST=localhost
SMTP_PORT=1025

RESEND_API_KEY=
SENTRY_DSN=

# The closed list of addresses cleared to register, separated by commas or
# newlines. Unset or empty means nobody can sign up — never the other way
# around. Fill it in before trying the sign up flow locally.
SIMI_ALLOWED_SIGNUP_EMAILS=

# macOS only: the precompiled pg gem segfaults inside the workers solid_queue
# forks, which silently stops every deliver_later in development.
PGGSSENCMODE=disable
